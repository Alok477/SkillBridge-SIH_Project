# Local development only. Never commit backend/.env.
ENVIRONMENT=development

# Local MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=academia_portal

# Optional full SQLAlchemy URL (overrides the MYSQL_* values)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/academia_portal?charset=utf8mb4

# JWT
JWT_SECRET=generate-a-long-random-secret-for-local-development
JWT_EXPIRE_MINUTES=1440

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

HOST=0.0.0.0
PORT=8000
